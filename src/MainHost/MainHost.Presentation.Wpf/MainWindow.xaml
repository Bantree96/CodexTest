<Window x:Class="MainHost.Presentation.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Main Host" Height="450" Width="800">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="18" FontWeight="Bold" Text="Loaded Modules" />

        <ItemsControl Grid.Row="1" ItemsSource="{Binding ModuleNames}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,8,0,0" Padding="8" BorderBrush="Gray" BorderThickness="1">
                        <TextBlock Text="{Binding}" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
